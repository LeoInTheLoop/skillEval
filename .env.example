# 这里只放密钥和端点。用哪个模型、什么参数，在 evals/suites/*.yaml 里配
# （suite 用 api_base_env / api_key_env 引用下面的变量名，值永不进 suite、不进 git）。
#
#   cp .env.example .env      然后把 REPLACE_ME 换成真 key
#
# 只想验证链路、不想花钱：不用配任何 key，加 --mock 跑（见 README「60 秒跑起来」）。
# 忘了替换也不会白花钱 —— `pipeline plan` 会认出占位符并拒绝执行。

# DashScope（阿里云百炼，OpenAI 兼容端点）。国际站换成 dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-REPLACE_ME

# 智谱 GLM（OpenAI 兼容端点）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=REPLACE_ME

# 再加别的 provider：在这里加变量，再到 suite 的 models: 里引用变量名即可。
# 换模型/换 provider 都不用改代码，也不用改 .env 里已有的行 —— 只改 suite。
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-REPLACE_ME

# --- 判分模型（grade.py 判 expect_assertions 用）---
# **和上面的被测模型分开配**：被测模型是实验对象，judge 是量具。
# 拿被测模型给自己判分，等于让考生改自己的卷子；用独立变量才能换成另一家的模型来判。
# suite 的 scoring.judge 默认就引用这两个名字，不写 api_base_env/api_key_env 就是它们。
# 只跑 routing 评测的话这两行用不到，可以先不管。
JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JUDGE_API_KEY=REPLACE_ME
# 想让 judge 走 DashScope，就把上面两行改成 DashScope 的值；
# 想在 suite 里直接指到已有变量，写 api_base_env: GLM_BASE_URL 即可，本节可留空。
